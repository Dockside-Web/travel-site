---
// One post: title, byline, photo, the Markdown body, then the demo and two
// more posts. Its link preview is the post's photo cropped to 1200 × 630.
import { Image } from "astro:assets";
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import Pin from "../../components/Pin.astro";
import PostCard from "../../components/blog/PostCard.astro";
import { demoUrl, signupUrl } from "../../lib/links";
import { site } from "../../site.config";
import { formatDate, getPosts, readingTime, shareImage, type Post } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}
const { post, posts } = Astro.props;
const { title, description, pubDate, author, hero, heroAlt } = post.data;
const { Content } = await render(post);

const image = await shareImage(hero);
const more = posts.filter((p) => p.id !== post.id).slice(0, 2);

// Structured data: the article, and Home › Blog › this post for Google's breadcrumbs.
const base = Astro.site ?? Astro.url;
const url = new URL(`/blog/${post.id}`, base).href;
const schema = [
  {
    "@type": "BlogPosting",
    "@id": `${url}#article`,
    headline: title,
    description,
    image: new URL(image, base).href,
    datePublished: pubDate.toISOString(),
    dateModified: pubDate.toISOString(),
    author: { "@type": "Person", name: author },
    publisher: { "@id": `${new URL("/", base).href}#business` },
    mainEntityOfPage: url,
    inLanguage: site.lang,
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", base).href },
      { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog", base).href },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];
---

<Layout
  title={title}
  description={description}
  type="article"
  image={image}
  imageAlt={heroAlt}
  publishedTime={pubDate}
  author={author}
  schema={schema}
>
  <article class="pt-14 pb-20 md:pt-20 md:pb-28">
    <header class="mx-auto max-w-[46rem] px-4 sm:px-8">
      <nav aria-label="Breadcrumb" class="mb-6 font-ui text-[0.95rem]">
        <a href="/blog" class="text-slate-deep no-underline hover:text-ink"><span aria-hidden="true">←</span> Blog</a>
      </nav>
      <h1 class="mb-5 text-[2.6rem] leading-[1.05] font-semibold tracking-tight text-ink md:text-[3.6rem]">{title}</h1>
      <p class="mb-7 text-xl leading-normal text-body md:text-[1.4rem]">{description}</p>
      <p class="flex flex-wrap items-center gap-x-2 font-ui text-[0.95rem] text-muted">
        <span class="font-semibold text-ink">{author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post)}</span>
      </p>
    </header>

    <div class="mx-auto mt-12 max-w-6xl px-4 sm:px-8 md:mt-14">
      <Image
        src={hero}
        alt={heroAlt}
        widths={[640, 960, 1280, 1800]}
        sizes="(min-width: 1152px) 1088px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[16/9] w-full rounded-2xl object-cover shadow-[0_40px_80px_-40px_rgba(35,49,61,0.55)]"
      />
    </div>

    <div class="post-body mx-auto mt-14 px-4 sm:px-0 md:mt-16">
      <Content />
    </div>
  </article>

  <!-- The demo, then two more posts -->
  <section class="bg-fog py-20 md:py-24">
    <div class="mx-auto flex max-w-[46rem] flex-wrap items-center gap-x-10 gap-y-6 px-4 sm:px-8">
      <Pin color="sand" hole="#e9eef0" class="h-14 w-auto flex-none" />
      <div class="min-w-0 flex-[1_1_22rem]">
        <h2 class="mb-2 text-3xl leading-tight font-semibold text-ink">See it full of trips first.</h2>
        <p class="text-body">The demo account has years of trips, spots and split costs to click around. Nothing you do there is saved.</p>
      </div>
      <div class="grid w-full gap-3 min-[420px]:flex">
        <Button href={demoUrl} rel="nofollow" variant="slate" arrow>Try the demo</Button>
        <Button href={signupUrl}>Get Started</Button>
      </div>
    </div>
  </section>

  {
    more.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 py-20 sm:px-8 md:py-28">
        <h2 class="section-title mb-12">More from the blog</h2>
        <div class="grid gap-x-10 gap-y-16 sm:grid-cols-2 lg:max-w-[52rem]">
          {more.map((p, i) => (
            <PostCard post={p} index={i + 1} headingLevel="h3" />
          ))}
        </div>
      </section>
    )
  }
</Layout>

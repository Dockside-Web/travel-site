---
// /blog: the newest post large, then the rest in a grid.
import Layout from "../../layouts/Layout.astro";
import PostCard from "../../components/blog/PostCard.astro";
import PageHero from "../../components/PageHero.astro";
import { getPosts } from "../../lib/blog";

const [newest, ...rest] = await getPosts();

const metaDescription =
  "Notes on keeping track of your travels: mapping where you've been, remembering the spots worth going back to, sharing tips and splitting the costs.";
---

<Layout title="Blog" description={metaDescription} nav="overlay">
  <PageHero
    title="Notes from the map."
    lede="How to remember where you've been, keep the places worth going back to, and settle up with the friends you went with."
    slice="62%"
    seed={31}
    stamp={["NOTES", "THE BLOG"]}
  />
  <section class="mx-auto max-w-7xl px-4 pt-14 pb-24 sm:px-8 md:pt-20 md:pb-32">

    {
      newest ? (
        <>
          <PostCard post={newest} wide />
          {rest.length > 0 && (
            <div class="mt-20 grid gap-x-10 gap-y-16 border-t border-line pt-16 sm:grid-cols-2 lg:grid-cols-3 md:mt-28">
              {rest.map((post, i) => (
                <PostCard post={post} index={i + 1} />
              ))}
            </div>
          )}
        </>
      ) : (
        <p class="text-xl text-body">The first posts are on their way.</p>
      )
    }
  </section>
</Layout>

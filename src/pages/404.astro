---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import PageHero from "../components/PageHero.astro";
---

<Layout title="Page Not Found" noindex nav="overlay">
  <PageHero title="Off the map." lede="There's nothing at this address. It may have moved, or the link may be mistyped." slice="75%" seed={59} stamp={["LOST", "OFF MAP"]}>
    <div class="mt-8 grid min-[420px]:flex">
      <Button href="/" arrow>Back to the home page</Button>
    </div>
  </PageHero>
  <div class="h-24 md:h-32"></div>
</Layout>

---
// Privacy and Terms: the hero every inner page has, then the page on a white card
// (a "Last updated" line, the sections, and how to reach us at the end), then
// the closing band. Pages write plain <section>s with <h2>, <h3>, <p> and <ul>;
// the styles below dress them. <div class="note"> is a tinted box for an aside.
import Layout from "./Layout.astro";
import CTA from "../components/CTA.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../site.config";

interface Props {
  title: string;
  // 140-160 characters, for Google.
  description: string;
  // e.g. "November 11, 2026"
  updated: string;
  // true until the page has been reviewed: keeps it out of Google.
  noindex?: boolean;
  // Which slice of the hero's photo, and which tear (see PageHero).
  slice?: string;
  seed?: number;
}
const { title, description, updated, noindex = false, slice = "38%", seed = 43 } = Astro.props;
const { email } = site.business;
---

<Layout title={title} description={description} noindex={noindex} nav="overlay">
  <PageHero title={title} lede={site.legalName} slice={slice} seed={seed} />
  <div class="px-4 py-12 sm:px-6 md:py-16 lg:px-8">
    <div class="legal mx-auto max-w-4xl overflow-hidden rounded-2xl bg-white shadow-[0_24px_50px_-30px_rgba(35,49,61,0.45)]">
      <div class="space-y-10 px-6 py-8 sm:px-10 sm:py-10">
        <div class="rounded-r-lg border-l-4 border-slate bg-fog px-4 py-3.5">
          <p class="font-ui text-sm font-semibold text-ink">Last updated: <span class="text-slate">{updated}</span></p>
        </div>

        <slot />

        <section class="rounded-xl border border-line bg-linen p-6">
          <h2>Contact us</h2>
          <p class="text-lg font-semibold text-ink">{site.legalName}</p>
          <p>Email: <a href={`mailto:${email}`}>{email}</a></p>
        </section>
      </div>
    </div>
  </div>

  <CTA />
</Layout>

<style>
  .legal :global(h2) {
    margin-bottom: 1rem;
    font-size: 1.65rem;
    line-height: 1.2;
    font-weight: 600;
    color: var(--color-ink);
  }
  .legal :global(h3) {
    margin-bottom: 0.6rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .legal :global(h4) {
    font-family: var(--font-ui);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .legal :global(p),
  .legal :global(li) {
    color: var(--color-body);
    font-size: 1.05rem;
    line-height: 1.65;
  }
  .legal :global(p + p),
  .legal :global(p + ul),
  .legal :global(ul + p) {
    margin-top: 0.75rem;
  }
  .legal :global(section ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .legal :global(section li + li) {
    margin-top: 0.3rem;
  }
  .legal :global(section > div + div) {
    margin-top: 1.5rem;
  }
  .legal :global(.items > div + div) {
    margin-top: 0.85rem;
  }
  .legal :global(a) {
    color: var(--color-slate);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal :global(a:hover) {
    color: var(--color-slate-deep);
  }
  .legal :global(.note) {
    margin-top: 0.85rem;
    border: 1px solid #cfdbe2;
    border-radius: 0.6rem;
    background: var(--color-fog);
    padding: 0.8rem 1rem;
  }
  .legal :global(.note p) {
    font-size: 0.95rem;
  }
</style>

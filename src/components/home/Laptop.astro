---
// The app's My World map on a laptop.
import { Image } from "astro:assets";
import myWorld from "../../assets/app-my-world.png";

interface Props {
  class?: string;
  eager?: boolean;
}
const { class: className, eager = false } = Astro.props;
---

<div class={className}>
  <div class="rounded-t-xl rounded-b-sm bg-[#1c2128] p-1.5 pb-2.5 shadow-[0_40px_80px_-24px_rgba(0,0,0,0.55)] sm:rounded-t-2xl sm:p-2.5 sm:pb-3.5">
    <div class="aspect-16/10 overflow-hidden rounded bg-[#a4c0c6]">
      <Image
        src={myWorld}
        alt="My World in the app: a map of the world with every country visited shaded green, pins on the places, and 22 countries, 24 US states, 47 cities and 5 continents counted at the top."
        widths={[600, 900, 1240]}
        sizes="(min-width: 1024px) 600px, 100vw"
        loading={eager ? "eager" : "lazy"}
        class="block h-full w-full object-cover object-top-left"
      />
    </div>
  </div>
  <div aria-hidden="true" class="-mx-2 h-3 rounded-b-xl bg-[linear-gradient(180deg,#d5d8dc,#8e939a)] sm:-mx-3 sm:h-4 lg:mx-[-6%]"></div>
</div>

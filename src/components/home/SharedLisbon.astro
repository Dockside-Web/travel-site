---
// The demo account's Lisbon & Porto share link as a friend opens it: a real
// screenshot of the app (src/assets/app-share-lisbon.png, 472 wide at 2x,
// logged out), shown tall in a drawn browser window. Retake it when the app's
// look changes.
import { Image } from "astro:assets";
import screen from "../../assets/app-share-lisbon.png";

interface Props {
  class?: string;
  // Show it scrolled down by this many pixels of the 472-wide page, e.g. 260
  // to start at the title, below the cover photo.
  scroll?: number;
}
const { class: className, scroll = 0 } = Astro.props;
// A percentage margin is a share of the width, so it scales with the frame.
const offset = scroll ? `margin-top: -${((scroll / 472) * 100).toFixed(2)}%` : undefined;
---

<div
  class:list={[
    // Tall enough on wide screens to reach the spots, below the photo and the map.
    "relative h-144 w-full max-w-118 overflow-hidden rounded-[14px] bg-app-paper shadow-[0_40px_80px_-30px_rgba(35,49,61,0.5)] sm:h-184 lg:h-280",
    className,
  ]}
>
  <div aria-hidden="true" class="flex h-8.5 items-center gap-1.75 bg-[#ebe6dd] px-3.5 font-ui">
    <span class="size-2.5 rounded-full bg-[#e2a08f]"></span>
    <span class="size-2.5 rounded-full bg-[#ecc977]"></span>
    <span class="size-2.5 rounded-full bg-[#a9c49a]"></span>
    <span class="ml-3 flex h-5 flex-1 items-center rounded-md bg-[#f8f5ef] px-2.5 text-[11px] text-[#8a8a80]">travel map &amp; journal · shared link</span>
  </div>
  <Image
    src={screen}
    alt="The Lisbon & Porto trip as a friend sees it from a share link: the cover photo, dates, a map, then the spots with stars and notes."
    widths={[472, 944]}
    sizes="(min-width: 480px) 472px, 100vw"
    class="block w-full"
    style={offset}
  />
</div>

---
// Wide screens: words on the left, the laptop on the right, the board across
// the torn edge. Narrower screens: words, then the board across the edge
// (so it's on the first screen), then the laptop and phone together below it.
import { Image } from "astro:assets";
import { demoUrl, signupUrl } from "../../lib/links";
import Button from "../Button.astro";
import DepartureBoard from "./DepartureBoard.astro";
import Laptop from "./Laptop.astro";
import PhoneTrip from "./PhoneTrip.astro";
import TornEdge from "./TornEdge.astro";
import photo from "../../assets/hero-lake-calm.jpg";
---

<section class="relative pb-24 text-white md:pb-32 lg:pb-36">
  <Image
    src={photo}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-[center_45%]"
  />
  <!-- Shade across the top for the nav, and behind the words on the left -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(35,49,61,0.5)_0%,rgba(35,49,61,0)_20%),linear-gradient(90deg,rgba(35,49,61,0.85)_0%,rgba(35,49,61,0.5)_45%,rgba(35,49,61,0.05)_78%)]"
  >
  </div>
  <!-- On narrower screens the words cross the whole photo, so darken all of it -->
  <div aria-hidden="true" class="absolute inset-0 bg-ink/40 lg:hidden"></div>

  <div class="relative mx-auto flex max-w-7xl items-center gap-12 px-4 pt-28 sm:px-8 md:pt-40">
    <div class="max-w-[40rem] flex-[1_1_30rem]">
      <h1 class="mb-5 text-[2.9rem] leading-[0.98] font-semibold tracking-tight sm:text-7xl lg:text-[5.25rem]">
        Your travels, <em>beautifully mapped.</em>
      </h1>
      <p class="mb-8 max-w-[32rem] text-lg leading-normal sm:text-xl md:text-[1.3rem]">
        Remember where you've been, keep the spots worth going back to, and share the best of any trip or city with one link.
      </p>
      <div class="grid gap-3 min-[420px]:flex min-[420px]:flex-wrap">
        <Button href={signupUrl} size="lg" arrow>Get Started</Button>
        <Button href={demoUrl} rel="nofollow" size="lg" variant="outline">Try the demo</Button>
      </div>
    </div>

    <Laptop class="hidden min-w-0 flex-[1_1_30rem] lg:block lg:max-w-[37.5rem]" eager />
  </div>

  <TornEdge fill="#f6f2ea" />
</section>

<!-- The board sits across the torn edge -->
<div class="relative z-10 -mt-14 px-4 text-center md:-mt-20 lg:-mt-24">
  <DepartureBoard />
</div>

<!-- Narrower screens: the laptop, with the Mexico City phone standing in front
     of its right corner. (Spots leaves its phone out at these sizes.) The
     phone is drawn full size and scaled down inside a box of its scaled size. -->
<div class="relative mx-auto max-w-[37.5rem] px-6 pt-20 pb-6 sm:px-10 md:pt-24 lg:hidden">
  <Laptop class="mr-[20%]" />
  <div class="absolute right-5 bottom-0 h-[246px] w-[120px] sm:right-8 sm:h-[344px] sm:w-[168px]">
    <PhoneTrip class="origin-top-left scale-50 -rotate-3 sm:scale-70" />
  </div>
</div>

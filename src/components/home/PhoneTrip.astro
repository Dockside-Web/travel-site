---
// A phone showing the demo account's Mexico City trip: a real screenshot of
// the app (src/assets/app-trip-phone.png, 390 × 844 at 2x, light), in a
// drawn phone. Retake it when the app's look changes.
import { Image } from "astro:assets";
import screen from "../../assets/app-trip-phone.png";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={["h-123 w-60 rounded-[38px] bg-[#1c2128] p-2.25 shadow-[0_40px_80px_-15px_rgba(0,0,0,0.65)]", className]}>
  <div class="relative h-full overflow-hidden rounded-[30px] bg-app-paper">
    <Image
      src={screen}
      alt="The Mexico City trip in the app on a phone: its cover photo, dates, who went, and its spots with stars."
      widths={[222, 444, 666]}
      sizes="222px"
      class="h-full w-full object-cover object-top"
    />
  </div>
</div>

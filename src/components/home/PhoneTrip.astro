---
// A phone showing a trip page, drawn in the app's own style from the demo
// account's Mexico City trip. Built in HTML rather than a screenshot so it
// stays sharp at this small size.
import { Image } from "astro:assets";
import cover from "../../assets/trip-mexico-city.png";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const spots = [
  { name: "Contramar", note: "Tuna tostadas", color: "bg-app-eat", stars: 5, fav: true },
  { name: "Museo Nacional de Antropología", note: "", color: "bg-app-see", stars: 5, fav: false },
  { name: "Licorería Limantour", note: "Margarita al pastor", color: "bg-app-drink", stars: 4, fav: false },
  { name: "Panadería Rosetta", note: "Guava roll", color: "bg-app-eat", stars: 5, fav: false },
];
---

<div
  class:list={["h-123 w-60 rounded-[38px] bg-[#1c2128] p-2.25 shadow-[0_40px_80px_-15px_rgba(0,0,0,0.65)]", className]}
  role="img"
  aria-label="The Mexico City trip on a phone: Contramar, the Museo Nacional de Antropología, Licorería Limantour and Panadería Rosetta, each with stars and what was ordered."
>
  <div class="relative h-full overflow-hidden rounded-[30px] bg-app-paper font-ui text-ink" aria-hidden="true">
    <div class="relative h-39.5 overflow-hidden">
      <Image src={cover} alt="" widths={[222, 444]} sizes="222px" class="h-full w-full object-cover" />
      <span class="absolute top-1.75 left-1/2 h-5 w-18.5 -translate-x-1/2 rounded-full bg-[#1c2128]"></span>
      <span class="absolute top-10 left-3 flex size-7 items-center justify-center rounded-full bg-app-paper/90 text-sm">‹</span>
    </div>
    <div class="px-3.5 pt-3">
      <p class="text-[9px] font-semibold tracking-[0.12em] text-app-muted">MEXICO CITY, MEXICO</p>
      <p class="mt-0.5 font-serif text-[25px] leading-tight font-medium">Mexico City</p>
      <p class="mb-2.5 text-[9px] font-semibold tracking-widest text-app-muted">FEB 14 – 19, 2026 · 6 DAYS</p>
      <div class="flex gap-3.5 border-b border-app-line pb-2 text-[11px]">
        <span><strong>4</strong> spots</span><span><strong>1</strong> favorite</span><span><strong>4.8</strong> avg</span>
      </div>
      <p class="mt-2.5 mb-1 font-serif text-base">Spots</p>
      {
        spots.map((s, i) => (
          <div class:list={["flex items-center gap-2 py-1.75", i < spots.length - 1 && "border-b border-app-line"]}>
            <span class:list={["size-1.75 flex-none rounded-full", s.color]} />
            <span class="flex-1 font-serif text-[13px] leading-tight">
              {s.name}
              {s.fav && <span class="text-app-star"> ♥</span>}
              {s.note && (
                <>
                  <br />
                  <span class="font-ui text-[10px] text-app-muted">{s.note}</span>
                </>
              )}
            </span>
            <span class="text-[9px] text-app-star">
              {"★".repeat(s.stars)}
              <span class="text-app-line">{"★".repeat(5 - s.stars)}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</div>

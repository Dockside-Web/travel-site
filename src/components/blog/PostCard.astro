---
// A post on /blog and under "More from the blog": its photo with a passport
// stamp of the date, the title and the summary. `wide` lays it out side by
// side, for the newest post at the top of /blog.
import { Image } from "astro:assets";
import Stamp from "../Stamp.astro";
import { formatDate, readingTime, type Post } from "../../lib/blog";

interface Props {
  post: Post;
  wide?: boolean;
  // Alternates the stamp's tilt and ink down a list.
  index?: number;
  headingLevel?: "h2" | "h3";
}
const { post, wide = false, index = 0, headingLevel: Heading = "h2" } = Astro.props;
const { title, description, pubDate, hero, heroAlt } = post.data;

const inks = ["#a64f2c", "#4a6a86", "#23313d"];
const month = pubDate.toLocaleDateString("en-US", { month: "short", timeZone: "UTC" }).toUpperCase();
const stamp: [string, string] = [`${month} ${pubDate.getUTCDate()}`, String(pubDate.getUTCFullYear())];
---

<article class:list={["group relative", wide && "grid items-center gap-x-14 gap-y-8 md:grid-cols-[1.15fr_1fr]"]}>
  <div class="relative">
    <div class:list={["overflow-hidden rounded-2xl shadow-[0_24px_40px_-26px_rgba(35,49,61,0.6)]", wide ? "aspect-4/3" : "aspect-3/2"]}>
      <Image
        src={hero}
        alt={heroAlt}
        widths={wide ? [600, 900, 1200] : [400, 640, 900]}
        sizes={wide ? "(min-width: 768px) 640px, 100vw" : "(min-width: 768px) 380px, 100vw"}
        class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
      />
    </div>
    <Stamp lines={stamp} ink={inks[index % inks.length]} tilt={index % 2 ? 9 : -8} class="absolute -top-4 -right-2 md:-right-4" />
  </div>

  <div class:list={[!wide && "mt-6"]}>
    <p class="mb-2 font-ui text-[0.9rem] text-muted">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time> · {readingTime(post)}
    </p>
    <Heading class:list={["mb-3 leading-[1.12] font-semibold text-ink", wide ? "text-4xl md:text-[2.75rem]" : "text-[1.65rem]"]}>
      <!-- The link covers the whole card -->
      <a href={`/blog/${post.id}`} class="text-ink no-underline after:absolute after:inset-0 group-hover:text-slate-deep">{title}</a>
    </Heading>
    <p class:list={["text-body", wide ? "text-xl" : "text-[1.05rem]"]}>{description}</p>
    {wide && <p class="mt-6 font-ui font-semibold text-slate-deep">Read it <span aria-hidden="true">→</span></p>}
  </div>
</article>

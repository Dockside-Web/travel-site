---
// A map pin.
interface Props {
  color?: "slate" | "sand" | "ink";
  // Colour of the hole in the head, to match the background behind it.
  hole?: string;
  class?: string;
  style?: string;
}
const { color = "slate", hole = "#f6f2ea", class: className = "h-11 w-auto", style } = Astro.props;
const fills: Record<string, string> = { slate: "#4a6a86", sand: "#d8b48a", ink: "#23313d" };
---

<svg class={className} style={style} viewBox="0 0 34 44" aria-hidden="true">
  <path d="M17 1C8.2 1 1 8 1 16.7 1 28.5 17 43 17 43s16-14.5 16-26.3C33 8 25.8 1 17 1z" fill={fills[color]}></path>
  <circle cx="17" cy="16.5" r="5.5" fill={hole}></circle>
</svg>

---
// The closing band: a still fjord, one line, the privacy promise and Get
// Started (the demo section just above has its own button). Its top is torn,
// like the hero's bottom, so the page opens and closes the same way.
import { Image } from "astro:assets";
import { signupUrl } from "../lib/links";
import Button from "./Button.astro";
import TornEdge from "./home/TornEdge.astro";
import photo from "../assets/band-reine.jpg";
---

<section class="relative flex min-h-[30rem] items-center justify-center text-center text-white">
  <Image src={photo} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="absolute inset-0 h-full w-full object-cover object-[center_55%]" />
  <div aria-hidden="true" class="absolute inset-0 bg-ink/45"></div>
  <TornEdge fill="#e9eef0" position="top" seed={53} />
  <div class="relative px-4 py-32">
    <h2 class="mb-4 text-4xl leading-tight font-semibold [text-shadow:0_2px_20px_rgba(0,0,0,0.3)] md:text-[3.5rem]">
      Ready to start pinning your travels?
    </h2>
    <p class="mx-auto mb-8 max-w-[34rem] text-lg leading-normal [text-shadow:0_1px_12px_rgba(0,0,0,0.35)] md:text-xl">
      Yours alone: no feed, no followers. Download all of it, any time.
    </p>
    <Button href={signupUrl} size="lg" arrow>Get Started</Button>
  </div>
</section>

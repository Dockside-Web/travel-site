---
import { site } from "../../site.config";
import { shareImage } from "../../lib/blog";
import defaultPhoto from "../../assets/hero-lake-calm.jpg";

export interface Props {
  // Page name, e.g. "About". Leave empty on the homepage.
  title?: string;
  // Unique per page, 140-160 chars, written for humans (it's the Google snippet).
  description?: string;
  // Social share image for this page. A path in /public or an imported image's .src.
  image?: string;
  imageAlt?: string;
  // true = keep this page out of Google (drafts, legal pages, etc.).
  noindex?: boolean;
  type?: "website" | "article";
  // Articles only: for link previews and search engines.
  publishedTime?: Date;
  modifiedTime?: Date;
  author?: string;
}

const {
  title,
  description: pageDescription,
  image = site.ogImage,
  imageAlt = site.ogImageAlt,
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
  author,
} = Astro.props;


const description = pageDescription || site.description;
// "Page | Name" on inner pages, "Name | Tagline" on the homepage.
const fullTitle = (title ? [title, site.name] : [site.name, site.tagline]).filter(Boolean).join(" | ");

// One canonical URL per page: no trailing slash, no .html, no query string.
const base = Astro.site ?? Astro.url;
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "").replace(/(.)\/$/, "$1");
const canonicalURL = new URL(path || "/", base).href;
// With no image set anywhere, the home page's lake photo cropped to 1200 × 630.
const imageURL = new URL(image || (await shareImage(defaultPhoto)), base).href;
const imageDescription = image ? imageAlt : "A calm lake below misty mountains";
---

{/* Primary */}
<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}
{!noindex && <link rel="canonical" href={canonicalURL} />}
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
{site.themeColor && <meta name="theme-color" content={site.themeColor} />}

{/* Open Graph (Facebook, LinkedIn, iMessage, Slack, etc.) */}
<meta property="og:type" content={type} />
{site.name && <meta property="og:site_name" content={site.name} />}
<meta property="og:locale" content={site.locale} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
{
  imageURL && (
    <>
      <meta property="og:image" content={imageURL} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      {imageDescription && <meta property="og:image:alt" content={imageDescription} />}
    </>
  )
}

{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{author && <meta name="author" content={author} />}

{/* Twitter / X */}
<meta name="twitter:card" content={imageURL ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
{imageURL && <meta name="twitter:image" content={imageURL} />}
{imageDescription && <meta name="twitter:image:alt" content={imageDescription} />}

{/* Search console verification */}
{site.verification.google && <meta name="google-site-verification" content={site.verification.google} />}
{site.verification.bing && <meta name="msvalidate.01" content={site.verification.bing} />}

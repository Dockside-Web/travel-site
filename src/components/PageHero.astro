---
// The hero of every page but the home page: the lake photo behind the nav
// (the page's Layout needs nav="overlay"), the title in white, and a torn-paper
// edge into the page below, as the home page's hero has. Shorter than the home
// page's, and each page shows a different slice of the photo (`slice`).
//
// Slots: "above" (a breadcrumb), the default slot (buttons or a byline, under
// the lede) and "aside" (a picture on the right, on wide screens beside the
// words: the feature pages' app screens). `stamp` puts a passport stamp there.
import { Image } from "astro:assets";
import TornEdge from "./home/TornEdge.astro";
import Stamp from "./Stamp.astro";
import photo from "../assets/hero-lake-calm.jpg";

interface Props {
  title: string;
  lede?: string;
  // Which part of the photo shows, top to bottom: "20%" is the peaks, "80%" the water.
  slice?: string;
  // The colour of the section the edge tears into.
  fill?: string;
  // A different seed tears a different edge.
  seed?: number;
  stamp?: [string, string];
  // Smaller type, for long titles (blog posts).
  long?: boolean;
}
const { title, lede, slice = "45%", fill = "#f6f2ea", seed = 23, stamp, long = false } = Astro.props;
const hasAside = Astro.slots.has("aside");
---

<section class="relative text-white">
  <Image
    src={photo}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover"
    style={`object-position: center ${slice}`}
  />
  <!-- Shade across the top for the nav, and all of it so the words read anywhere -->
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[linear-gradient(180deg,rgba(35,49,61,0.55)_0%,rgba(35,49,61,0.2)_30%),linear-gradient(90deg,rgba(35,49,61,0.88)_0%,rgba(35,49,61,0.62)_50%,rgba(35,49,61,0.3)_100%)]"
  >
  </div>

  <div
    class:list={[
      "relative mx-auto flex max-w-7xl flex-wrap items-center gap-x-16 gap-y-12 px-4 pt-28 sm:px-8 md:pt-40",
      hasAside ? "pb-28 md:pb-32" : "pb-24 md:pb-28",
    ]}
  >
    <div class:list={["flex-[1_1_26rem]", hasAside ? "max-w-xl" : "max-w-184"]}>
      <slot name="above" />
      <h1
        class:list={[
          "font-semibold tracking-tight [text-shadow:0_2px_20px_rgba(0,0,0,0.25)]",
          long ? "text-[2.5rem] leading-[1.05] md:text-[3.5rem]" : "text-[2.9rem] leading-[1.02] md:text-[4.25rem]",
        ]}
      >
        {title}
      </h1>
      {lede && <p class="mt-5 max-w-xl text-lg leading-normal text-white/95 md:text-[1.3rem]">{lede}</p>}
      <slot />
    </div>

    {
      hasAside && (
        <div class="flex min-w-0 flex-[1_1_32rem] justify-center" data-reveal>
          <slot name="aside" />
        </div>
      )
    }
    {
      stamp && !hasAside && (
        <div class="ml-auto hidden pr-6 md:block lg:pr-16">
          <Stamp lines={stamp} ink="#23313d" tilt={9} class="scale-[1.45] shadow-[0_14px_30px_-10px_rgba(0,0,0,0.5)]" />
        </div>
      )
    }
  </div>

  <TornEdge fill={fill} seed={seed} />
</section>

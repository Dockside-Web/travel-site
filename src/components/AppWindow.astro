---
// A screenshot of the app in a simple browser window.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  // Widths the screenshot is shown at, for srcset.
  sizes?: string;
  shadow?: "light" | "dark";
}
const { src, alt, class: className, sizes = "(min-width: 1280px) 760px, 100vw", shadow = "light" } = Astro.props;
---

<div
  class:list={[
    "overflow-hidden rounded-[14px] bg-app-paper",
    shadow === "dark" ? "shadow-[0_50px_100px_-30px_rgba(0,0,0,0.6)]" : "shadow-[0_40px_80px_-30px_rgba(35,49,61,0.45)]",
    className,
  ]}
>
  <div class="flex h-8 items-center gap-1.5 bg-[#ebe6dd] px-3.5" aria-hidden="true">
    <span class="size-2.5 rounded-full bg-[#d8a48f]"></span>
    <span class="size-2.5 rounded-full bg-[#e7c97a]"></span>
    <span class="size-2.5 rounded-full bg-[#a9c49a]"></span>
  </div>
  <Image src={src} alt={alt} sizes={sizes} widths={[640, 960, 1280, 1600]} class="block h-auto w-full" />
</div>
